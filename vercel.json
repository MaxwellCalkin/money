{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "node scripts/build-vercel.mjs",
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; else exit 0; fi",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  }
}

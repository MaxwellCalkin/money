# Direct PostgreSQL connection for migrations; deployed API traffic normally
# uses the PgBouncer endpoint instead.
DATABASE_URL=postgres://money:replace-me@127.0.0.1:6432/money
MONEY_AUTO_MIGRATE=false
MONEY_ALLOW_DEV_FUNDING=false
MONEY_OPS_TOKEN=

# External payment authorizations are encrypted before database storage. Use
# versioned 32-byte keys (base64 or 64 hex characters) and select one active
# key. MONEY_EXTERNAL_HEADER_KEY remains a local v0.8 compatibility fallback.
MONEY_EXTERNAL_HEADER_KEYS={"2026-07":"replace-with-32-byte-base64"}
MONEY_EXTERNAL_HEADER_ACTIVE_KEY_ID=2026-07
MONEY_EXTERNAL_HEADER_KEY=

# Production x402 v2 exact/EVM rail. The API sends typed data to the HTTPS
# signer and verifies its response against MONEY_EVM_SIGNER_ADDRESS. RPC
# verification is independent of the seller/facilitator response.
MONEY_EVM_SIGNER_URL=https://signer.internal.example/x402
MONEY_EVM_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
MONEY_EVM_SIGNER_TOKEN=
MONEY_EVM_RPC_URLS={"eip155:84532":{"url":"https://replace-with-independent-rpc.example","confirmations":2}}

# Development only; refused when NODE_ENV=production.
MONEY_EVM_PRIVATE_KEY=

# Local protocol-shaped demo only. Refused when NODE_ENV=production.
MONEY_EXTERNAL_MOCK=false

# Use a login inheriting only money_worker in production.
MONEY_WORKER_DATABASE_URL=postgres://money_worker_login:replace-me@127.0.0.1:6432/money
MONEY_EXTERNAL_SWEEP_INTERVAL_MS=5000
MONEY_EXTERNAL_SWEEP_BATCH=100

# Use a login inheriting only money_key_rotation. Keep old and active keys in
# MONEY_EXTERNAL_HEADER_KEYS until a rotation run reports no candidates.
MONEY_KEY_ROTATION_DATABASE_URL=postgres://money_key_rotation_login:replace-me@127.0.0.1:6432/money
MONEY_EXTERNAL_ROTATION_BATCH=100
MONEY_EXTERNAL_ROTATION_MAX=10000

# Production treasury process identities. Each login inherits only the role
# named by the URL; never reuse the application or migration owner login.
MONEY_TREASURY_INGRESS_DATABASE_URL=postgres://money_treasury_ingress_login:replace-me@127.0.0.1:6432/money
MONEY_TREASURY_WORKER_DATABASE_URL=postgres://money_treasury_worker_login:replace-me@127.0.0.1:6432/money
MONEY_TREASURY_ADMIN_DATABASE_URL=postgres://money_treasury_login:replace-me@127.0.0.1:6432/money
MONEY_PAYOUT_DATABASE_URL=postgres://money_payout_worker_login:replace-me@127.0.0.1:6432/money
MONEY_RECONCILER_DATABASE_URL=postgres://money_reconciler_login:replace-me@127.0.0.1:6432/money

# Column sponsor-bank adapter. Give each process a separately rotatable key;
# never place the payout-originating credential in ingress or the product API.
MONEY_COLUMN_EVENT_API_KEY=
MONEY_COLUMN_PAYOUT_API_KEY=
MONEY_COLUMN_RECONCILER_API_KEY=
MONEY_COLUMN_WEBHOOK_SECRET=
MONEY_COLUMN_WEBHOOK_ENDPOINT_ID=
MONEY_COLUMN_RECONCILER_BANK_ACCOUNT_ID=
# Configure exactly one payout source in the payout worker.
MONEY_COLUMN_PAYOUT_BANK_ACCOUNT_ID=
MONEY_COLUMN_PAYOUT_ACCOUNT_NUMBER_ID=
TREASURY_WEBHOOK_PORT=4023
MONEY_TREASURY_EVENT_INTERVAL_MS=1000
MONEY_TREASURY_POLL_INTERVAL_MS=60000
MONEY_PAYOUT_INTERVAL_MS=1000
MONEY_RECONCILE_INTERVAL_MS=60000

# Optional read-only six-decimal USD stablecoin observations. No signing keys
# belong in this process.
MONEY_TREASURY_EVM_ASSETS=
# Example: [{"provider":"evm-base","rpcUrl":"https://rpc.example","walletAddress":"0x...","tokenAddress":"0x..."}]

# Compliance is split across narrow process identities. Ingress can enqueue
# only a signed result reference; the evidence and hosted-onboarding workers
# independently call the provider; the review worker can stop expired state;
# the browser console requires named operator sessions; ops is read-only.
MONEY_COMPLIANCE_INGRESS_DATABASE_URL=postgres://money_compliance_ingress_login:replace-me@127.0.0.1:6432/money
MONEY_COMPLIANCE_WORKER_DATABASE_URL=postgres://money_compliance_worker_login:replace-me@127.0.0.1:6432/money
MONEY_COMPLIANCE_ONBOARDING_DATABASE_URL=postgres://money_compliance_onboarding_login:replace-me@127.0.0.1:6432/money
MONEY_RISK_WORKER_DATABASE_URL=postgres://money_risk_worker_login:replace-me@127.0.0.1:6432/money
MONEY_COMPLIANCE_OPS_DATABASE_URL=postgres://money_compliance_ops_login:replace-me@127.0.0.1:6432/money
MONEY_COMPLIANCE_ADMIN_DATABASE_URL=postgres://money_compliance_admin_login:replace-me@127.0.0.1:6432/money
MONEY_COMPLIANCE_CONSOLE_DATABASE_URL=postgres://money_compliance_console_login:replace-me@127.0.0.1:6432/money

# Provider-neutral compliance adapter. The webhook contains only {id,
# resultRef}; normalized result evidence is fetched over authenticated HTTPS.
MONEY_COMPLIANCE_PROVIDER=replace-provider
MONEY_COMPLIANCE_PROVIDER_URL=https://compliance-provider.example
MONEY_COMPLIANCE_PROVIDER_API_KEY=
# Comma-separated bare HTTPS origins that may host the provider's inquiry UI.
MONEY_COMPLIANCE_HOSTED_ORIGINS=https://verify.compliance-provider.example
# Rotatable AES-256-GCM keys used only for short-lived hosted inquiry URLs.
# Example value: {"compliance-2026-07":"<32-byte-base64-or-64-hex>"}
MONEY_COMPLIANCE_SESSION_KEYS=
MONEY_COMPLIANCE_SESSION_ACTIVE_KEY_ID=
MONEY_COMPLIANCE_WEBHOOK_SECRET=
MONEY_COMPLIANCE_WEBHOOK_ENDPOINT_ID=
MONEY_COMPLIANCE_OPS_TOKEN=
COMPLIANCE_WEBHOOK_PORT=4024
COMPLIANCE_OPS_PORT=4025
COMPLIANCE_CONSOLE_PORT=4026
MONEY_COMPLIANCE_CONSOLE_URL=http://127.0.0.1:4026
MONEY_COMPLIANCE_EVENT_INTERVAL_MS=1000
MONEY_COMPLIANCE_ONBOARDING_INTERVAL_MS=1000
MONEY_COMPLIANCE_ONBOARDING_BATCH_SIZE=25
MONEY_COMPLIANCE_REVIEW_INTERVAL_MS=60000
MONEY_COMPLIANCE_REVIEW_BATCH_SIZE=100

# Set locally only while minting a 30-minute console session. Store the
# long-lived operator key in the approved secrets manager, never in this file.
MONEY_COMPLIANCE_OPERATOR_ID=
MONEY_COMPLIANCE_OPERATOR_KEY=

# Direct PostgreSQL connection for migrations; deployed API traffic normally
# uses the PgBouncer endpoint instead.
DATABASE_URL=postgres://money:replace-me@127.0.0.1:6432/money
MONEY_AUTO_MIGRATE=false
MONEY_ALLOW_DEV_FUNDING=false
MONEY_OPS_TOKEN=

# External payment authorizations are encrypted before database storage.
# Generate 32 random bytes and encode them as base64 or 64 hex characters.
MONEY_EXTERNAL_HEADER_KEY=

# Local protocol-shaped demo only. Refused when NODE_ENV=production.
MONEY_EXTERNAL_MOCK=false

# Use a login inheriting only money_worker in production.
MONEY_WORKER_DATABASE_URL=postgres://money_worker_login:replace-me@127.0.0.1:6432/money
MONEY_EXTERNAL_SWEEP_INTERVAL_MS=5000
MONEY_EXTERNAL_SWEEP_BATCH=100

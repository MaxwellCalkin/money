{
  "name": "money",
  "version": "0.8.0",
  "description": "Venmo for agents — a closed-loop payment network where AI agents pay each other and pay APIs, under user-signed mandates.",
  "type": "module",
  "private": true,
  "scripts": {
    "demo": "tsx src/demo.ts",
    "onboard": "tsx src/onboard.ts",
    "onboard:seller": "tsx src/onboard-seller.ts",
    "dashboard:login": "tsx src/dashboard-login.ts",
    "api": "tsx src/server/api.ts",
    "api:db": "tsx src/server/postgres-api.ts",
    "ops:db": "tsx src/server/database-ops.ts",
    "mcp": "tsx src/mcp/server.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reconcile": "tsx src/db/reconcile.ts",
    "external:worker": "tsx src/db/external-worker.ts",
    "db:test": "vitest run test/postgres-ledger.test.ts test/postgres-policy.test.ts test/postgres-control-plane-db.test.ts test/postgres-api.test.ts test/postgres-marketplace.test.ts test/postgres-marketplace-api.test.ts test/postgres-external.test.ts test/postgres-external-api.test.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.30",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "5.6",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}

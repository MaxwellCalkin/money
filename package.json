{
  "name": "money",
  "version": "0.14.0",
  "description": "Venmo for agents — a closed-loop payment network where AI agents pay each other and pay APIs, under user-signed mandates.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "deploy:preflight": "tsx src/deploy/preflight.ts",
    "demo": "tsx src/demo.ts",
    "demo:card": "tsx src/demo-card.ts",
    "onboard": "tsx src/onboard.ts",
    "onboard:seller": "tsx src/onboard-seller.ts",
    "dev:approve": "tsx src/dev-approve.ts",
    "seller:reader": "tsx src/seller/reader-service.ts",
    "build:packages": "node scripts/build-packages.mjs",
    "dashboard:login": "tsx src/dashboard-login.ts",
    "dashboard:preview": "tsx src/preview-dashboard.ts",
    "api": "tsx src/server/api.ts",
    "api:db": "tsx src/server/postgres-api.ts",
    "ops:db": "tsx src/server/database-ops.ts",
    "metrics:public": "tsx src/server/metrics.ts",
    "mcp": "tsx src/mcp/server.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:reconcile": "tsx src/db/reconcile.ts",
    "external:worker": "tsx src/db/external-worker.ts",
    "external:rotate-keys": "tsx src/db/external-key-rotation.ts",
    "treasury:webhooks": "tsx src/treasury/webhook-server.ts",
    "treasury:events": "tsx src/treasury/event-worker.ts",
    "treasury:payouts": "tsx src/treasury/payout-worker.ts",
    "treasury:reconcile": "tsx src/treasury/reconciler.ts",
    "treasury:setup": "tsx src/treasury/setup.ts",
    "compliance:webhooks": "tsx src/compliance/webhook-server.ts",
    "compliance:events": "tsx src/compliance/event-worker.ts",
    "compliance:onboarding": "tsx src/compliance/onboarding-worker.ts",
    "compliance:reviews": "tsx src/compliance/review-worker.ts",
    "compliance:ops": "tsx src/compliance/ops-server.ts",
    "compliance:console": "tsx src/compliance/console-server.ts",
    "cards:authorization": "tsx src/cards/authorization-server.ts",
    "cards:events": "tsx src/cards/event-worker.ts",
    "compliance:operator-setup": "tsx src/compliance/operator-setup.ts",
    "compliance:login": "tsx src/compliance/operator-login.ts",
    "db:test": "vitest run test/postgres-ledger.test.ts test/postgres-policy.test.ts test/postgres-control-plane-db.test.ts test/postgres-api.test.ts test/postgres-marketplace.test.ts test/postgres-marketplace-api.test.ts test/postgres-external.test.ts test/postgres-external-api.test.ts test/postgres-cards.test.ts test/postgres-cards-api.test.ts test/card-issuer-mock.test.ts test/card-workers.test.ts test/postgres-treasury.test.ts test/postgres-treasury-api.test.ts test/postgres-compliance.test.ts test/postgres-compliance-api.test.ts test/compliance-workers.test.ts test/compliance-onboarding.test.ts test/compliance-persona.test.ts test/compliance-console.test.ts test/treasury-column.test.ts test/treasury-workers.test.ts test/postgres-metrics.test.ts",
    "test:postgres-live": "vitest run test/postgres-live.test.ts --reporter=verbose",
    "lint:vocabulary": "node scripts/lint-vocabulary.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/node-server": "2.0.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "@x402/extensions": "^2.19.0",
    "hono": "^4.12.30",
    "pg": "^8.22.0",
    "viem": "^2.55.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "esbuild": "0.25.12",
    "tsx": "^4.23.1",
    "typescript": "5.6",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@hono/node-server": "$@hono/node-server",
    "esbuild": "0.25.12",
    "fast-uri": "3.1.6"
  }
}

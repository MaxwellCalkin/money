{$BETA_HOSTNAME} {
	encode gzip

	# Ops endpoints are proxied on distinct paths so UptimeRobot can watch
	# both services; the bearer token still gates anything sensitive.
	handle_path /ops-health* {
		reverse_proxy database-ops:4022
	}
	handle_path /ops-reconcile* {
		rewrite * /ops/reconcile
		reverse_proxy database-ops:4022
	}

	# Issuer webhooks (authorization decisions + async events) go straight to
	# the card authorization ingress; the path is preserved because the
	# service routes on /webhooks/:provider/....
	handle /webhooks/* {
		reverse_proxy card-authorization:4027
	}

	# Public wash-proof metrics: aggregates, funding lineage, weekly chain
	# roots, and receipt inclusion verification. Deliberately public — the
	# artifact itself is the product demo, honest zeroes included.
	handle /metrics* {
		reverse_proxy public-metrics:4028
	}
	handle /receipts/* {
		reverse_proxy public-metrics:4028
	}

	handle {
		reverse_proxy api:4021
	}
}

# Hosted beta secrets — copy to beta.env, fill, chmod 600. NEVER commit beta.env.
# Database password (openssl rand -base64 24):
BETA_DB_PASSWORD=
# Public hostname served by Caddy (free: yourname.duckdns.org):
BETA_HOSTNAME=
# DuckDNS token for the IP refresh cron (from duckdns.org):
DUCKDNS_TOKEN=
# Ops bearer token, 32+ chars (openssl rand -base64 32):
MONEY_OPS_TOKEN=
# Invite codes, JSON array, one per recruited pilot (openssl rand -base64 18 each):
MONEY_SIGNUP_INVITES=["replace-with-real-invite-code"]
# --- x402 bridge (leave unset until the bridge milestone; routes fail closed) ---
# Beta signer key (LocalEvmSigner; fund with the ~$15 float ONLY):
#MONEY_EVM_PRIVATE_KEY=
# JSON: {"eip155:84532": {"url": "https://sepolia.base.org"}} for testnet,
# then mainnet per docs/GOTOMARKET.md M1 bridge posture:
#MONEY_EVM_RPC_URLS=
# Header-encryption keyring per docs/EXTERNAL_SETTLEMENT.md:
#MONEY_EXTERNAL_HEADER_KEYS=
#MONEY_EXTERNAL_HEADER_ACTIVE_KEY_ID=
# --- reserved cards (sandbox, no real funds) ---
# The beta card rail runs the mock issuer: nothing here is a bank, card, or
# deposit account. `mock` is refused by production preflight, so this profile
# can never be promoted with these values. Flip to stripe-issuing test mode
# only per docs/CARD_RAIL.md.
MONEY_CARD_PROVIDER=mock
# PAN custody: `none` means no reveal surface exists at all (beta default).
MONEY_CARD_REVEAL_MODE=none
# Webhook verification for the card-authorization ingress: JSON array of 1-4
# secrets, each 24+ chars (openssl rand -base64 24 each):
MONEY_CARD_WEBHOOK_SECRETS=["replace-with-a-24-plus-character-webhook-secret"]
MONEY_CARD_WEBHOOK_ENDPOINT_ID=beta-mock-card-endpoint
# Read-only issuer event key for the card-events worker, 16+ chars
# (openssl rand -base64 18). Unused by the mock issuer but required at boot:
MONEY_CARD_EVENT_API_KEY=replace-with-16-plus-chars
# --- backups (Cloudflare R2 free tier, rclone remote named "r2") ---
# age public key for backup encryption (age-keygen; keep the private key OFF this VM):
BACKUP_AGE_RECIPIENT=
R2_BUCKET=agentmoney-beta-backups
